NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Payment mode: "mock" (default for local/CI) or "razorpay" (Test Mode demo)
PAYMENT_MODE=mock

# Razorpay Test Mode — server-only secrets (never expose to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key ID for Razorpay Checkout.js (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
